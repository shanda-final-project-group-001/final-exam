# 复制为 .env 后填入自己的百炼 Key，.env 不要提交到 Git
# 1) 在 https://bailian.console.aliyun.com/ 开通百炼并创建 API-KEY
# 2) 执行：Copy-Item .env.example .env，然后把下面第一行换成真实 Key
DASHSCOPE_API_KEY=sk-your-dashscope-key

# 模型接入（OpenAI 兼容模式，换模型只改 MODEL_NAME）
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen3.7-plus
# 抽样温度，演示时保持低温度更稳定
MODEL_TEMPERATURE=0.2
# 关闭推理模型的“思考”开关（1=关闭）。若模型不支持该参数，置 0 即可
MODEL_DISABLE_THINKING=1

# 数据与产出目录（可选，默认如下）
VOLUNTEER_DB=data/volunteer_demo.db
WORKSPACE_DIR=workspace

# 会话相关（可选）：聊天记录与 LangGraph 检查点分开存放
VOLUNTEER_SESSIONS_DB=data/volunteer_sessions.db
VOLUNTEER_STATE_DB=data/agent_state.db

# 调试用：设为 1 时把 AGENTS.md 直接拼进系统提示（默认交给 Memory 中间件）
# VOLUNTEER_INLINE_MEMORY=0
